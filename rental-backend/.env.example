# Server
PORT=5000
NODE_ENV=development

# Frontend origin — update this in production to your actual domain
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/rental

# JWT — use strong random secrets (min 64 chars) in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESSTOKEN_SECRET=your_access_secret_change_this_in_production
JWT_REFRESHTOKEN_SECRET=your_refresh_secret_change_this_in_production
JWT_ACCESSTOKEN_EXPIRES_IN=30m
JWT_REFRESHTOKEN_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Gmail — use App Password, not account password)
# Guide: https://myaccount.google.com/apppasswords
EMAIL_USERNAME=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
